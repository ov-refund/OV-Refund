{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OV Refund",
  "version": "0.1.1",
  "identifier": "nl.ovrefund.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.web3forms.com",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Local NS delay-compensation assistant",
    "longDescription": "OV Refund finds delayed NS train journeys in your own Mijn NS travel history and helps you claim compensation. Runs locally; no account, no commission.",
    "copyright": "OV Refund contributors. Not affiliated with NS or Translink.",
    "publisher": "OV Refund",
    "homepage": "https://ov-refund.github.io/OV-Refund/",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Dutch",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwOTUyN0UxN0QyOTBEOTAKUldTUURTbDk0U2VWa0t3b1I2SFBnaGFwRVZhVlhVd0Vtc3BFL3I1TUZLaVFRWmxNWEtSOUgxQXYK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
